# Kopieren nach .env und anpassen (die .env nicht ins Repository einchecken).

# Öffentliche Adresse des Beacons, mit https://
PUBLIC_URL=https://beacon.example.org

# Passwort für /admin – lang und zufällig, z. B. mit: openssl rand -base64 24
ADMIN_PASSWORD=

# Image-Version: latest oder fest, z. B. 1.4.0
# Reihenfolge bei Updates: erst die Chats, dann den Beacon.
BEACON_VERSION=latest

# Lokaler Port für den Reverse-Proxy
BEACON_PORT=8090

# 1 = nur Instanzen mit https:// / mit öffentlicher IP / ohne Port in der Adresse
HTTPS_ONLY=1
PUBLIC_ONLY=1
NO_PORTS=

# Rahmen für GIFs in Pixeln (100–1000)
GIF_SIZE=480

TZ=Europe/Berlin

# Nur bei einer eigenen, veränderten Fassung: Adresse deines Quellcodes (AGPL)
SOURCE_URL=
