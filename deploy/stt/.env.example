# UCNG – eigene Spracherkennung (speaches/faster-whisper): Einstellungen für deploy/stt/compose.yml
# Kopieren nach .env und anpassen.

# Whisper-Modell – derselbe Wert gehört als STT_MODEL zum Chat-Server (deploy/chat/.env)
# bzw. zum Sprach-Server, der diese Spracherkennung nutzt (deploy/voice/.env).
#   Systran/faster-whisper-small   CPU, gut für Deutsch (~0,5 GB)
#   Systran/faster-whisper-medium  genauer, braucht eine kräftige CPU
#   deepdml/faster-whisper-large-v3-turbo-ct2   mit NVIDIA-GPU (STT_IMAGE_TAG=latest-cuda)
STT_MODEL=Systran/faster-whisper-small

# latest-cpu oder (mit NVIDIA-GPU) latest-cuda – dann in compose.yml den GPU-Block einkommentieren
STT_IMAGE_TAG=latest-cpu

# So lange (Sekunden) bleibt das Modell nach der letzten Anfrage im Speicher; -1 = immer
STT_MODEL_TTL=-1

# Optional: Schlüssel für die Spracherkennung – dann denselben Wert als STT_TOKEN beim
# Chat-Server bzw. Sprach-Server setzen
STT_TOKEN=
