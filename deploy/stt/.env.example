# Kopieren nach .env und anpassen.

# Whisper-Modell – derselbe Wert gehört als STT_MODEL in deploy/chat/.env
STT_MODEL=Systran/faster-whisper-small

# latest-cpu oder (mit NVIDIA-GPU) latest-cuda
STT_IMAGE_TAG=latest-cpu

# Optional: Schlüssel für die Spracherkennung (dann auch STT_TOKEN in deploy/chat/.env)
STT_TOKEN=
