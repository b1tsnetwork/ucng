# Kopieren nach .env und anpassen (die .env nicht ins Repository einchecken).

# Derselbe Wert wie VOICE_AGENT_TOKEN beim Chat-Server
AGENT_TOKEN=

# Adresse dieses Sprach-Servers für Browser (wss://, ohne /ws)
PUBLIC_URL=wss://voice1.example.org

# Name in der Übersicht; bei mehreren Agenten auf einem Server je einen eigenen wählen
AGENT_ID=ucng-voice

# Chat-Server, wie der Agent ihn erreicht (gleicher Server: http://ucng:8080)
CHAT_URL=http://ucng:8080

# Wie der Chat-Server diesen Agenten erreicht (gleicher Server: http://<AGENT_ID>:8090/control)
CONTROL_URL=http://ucng-voice:8090/control

# Lokaler Port für den Reverse-Proxy
VOICE_PORT=8091

# Grenzen dieses Agenten
MAX_PARTICIPANTS=200
MAX_MBIT=50
MAX_PER_IP=5

UCNG_VERSION=latest
TRUSTED_PROXIES=

# Optional: eigene Spracherkennung (Whisper) für diesen Sprach-Server – leer = der Chat-Server
# verschriftlicht. Beispiel mit deploy/stt auf demselben Rechner:
STT_URL=http://ucng-stt:8000/v1/audio/transcriptions

STT_MODEL=Systran/faster-whisper-small
# Sprache fest vorgeben (z. B. de); leer = Sprache der jeweiligen Person
STT_LANGUAGE=
# Optional: Schlüssel für die Spracherkennung
STT_TOKEN=
# Live-Transkripte nach so vielen Tagen löschen (0 = behalten, bis der Admin sie löscht)
TRANSCRIPT_KEEP_DAYS=0
