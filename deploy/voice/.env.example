# UCNG – Sprach-Server (ucng-voice): alle Einstellungen für deploy/voice/compose.yml
# Kopieren nach .env und anpassen (die .env nicht ins Repository einchecken, Rechte 600).
# Leere Werte bedeuten „Standard“. Fest im Image: ADDR=:8090; TRUST_PROXY=1 setzt compose.yml.
# Ausführlich: docs/voice-deployment.md und README → Mehr Sprach-Server.

# ---------------------------------------------------------------- Anmeldung beim Chat-Server

# Derselbe Wert wie VOICE_AGENT_TOKEN beim Chat-Server (Pflicht)
AGENT_TOKEN=

# Adresse dieses Sprach-Servers für Browser, mit wss:// und ohne /ws (Pflicht)
PUBLIC_URL=wss://voice1.example.org

# Name in Admin → Sprach-Server; je Sprach-Server ein eigener (auch Container- und Rechnername)
AGENT_ID=ucng-voice

# Chat-Server, wie dieser Sprach-Server ihn erreicht.
# Gleicher Rechner (Docker-Netz des Chats): http://ucng:8080 · sonst z. B. https://chat.example.org
CHAT_URL=http://ucng:8080

# Wie der Chat-Server diesen Sprach-Server für Steuerbefehle erreicht (stummschalten, entfernen …).
# Gleicher Rechner: http://<AGENT_ID>:8090/control · eigener Rechner: https://voice1.example.org/control
# (im Reverse-Proxy /control nur für die IP-Adresse des Chat-Servers freigeben)
CONTROL_URL=http://ucng-voice:8090/control

# ---------------------------------------------------------------- Aufgabe (ROLE)

# Leer (Standard): voller Sprach-Server – übernimmt Sprachkanäle (Sprache, Mitschnitt für
#   Untertitel) und auf Wunsch auch Bildschirm und Kameras, auch ausgelagert für andere Kanäle.
# media: reiner Medien-Server – bekommt nie die Sprache eines Kanals, nur ausgelagerte
#   Bildschirmfreigaben und Kameras (und die zuerst). Für viel Upload-Bandbreite gedacht;
#   wann ausgelagert wird, stellt der Chat-Server ein (VOICE_OFFLOAD_SCREEN / _VIDEO).
ROLE=

# ---------------------------------------------------------------- Grenzen

# Teilnehmer insgesamt und ausgehende Bandbreite (Mbit/s, geschätzt – etwa 70–80 % des Uploads)
MAX_PARTICIPANTS=200
MAX_MBIT=50
# Verbindungen je IP-Adresse (je Person bis zu drei: Sprache, Bildschirm, Kameras – an Firmen-NAT denken)
MAX_PER_IP=40

# ---------------------------------------------------------------- Netz

# Lokaler Port für den Reverse-Proxy (nur an 127.0.0.1 gebunden)
VOICE_PORT=8091
# Seiten, von denen Browser verbinden dürfen (kommagetrennt). Leer = PUBLIC_URL des Chat-Servers
ALLOWED_ORIGINS=
# Vertrauenswürdige Proxys für X-Forwarded-For (leer = Loopback und private Netze)
TRUSTED_PROXIES=

# Image-Version: latest oder fest – am besten dieselbe wie beim Chat-Server
UCNG_VERSION=latest

# ---------------------------------------------------------------- Eigene Spracherkennung (optional)

# Gesetzt: Dieser Sprach-Server verschriftlicht selbst (z. B. Whisper auf einer GPU daneben) und
# schickt nur Text an den Chat-Server. Leer: Die Abschnitte gehen an den Chat-Server.
#   STT_URL=http://ucng-stt:8000/v1/audio/transcriptions
STT_URL=
STT_MODEL=Systran/faster-whisper-small
STT_TOKEN=
# Sprache fest vorgeben (z. B. de); leer = je Person bzw. Sprache der Live-Transkription
STT_LANGUAGE=
STT_CONCURRENCY=4
