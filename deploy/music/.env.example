# UCNG – Musik-Bot: alle Einstellungen für deploy/music/compose.yml
# Kopieren nach .env und anpassen (die .env nicht ins Repository einchecken, Rechte 600).
# Fest im Image: MUSIC_DIR=/music, TMP_DIR=/tmp. Ausführlich: examples/bot-music/README.md

# Token aus Admin → Bots, Rechte „Schreiben“ und „Musik“ (Pflicht)
UCNG_BOT_TOKEN=

# Chat-Server, wie der Bot ihn erreicht (gleicher Rechner: http://ucng:8080). Über einen
# Reverse-Proxy nur mit ungepuffertem Request-Body (nginx: proxy_request_buffering off;)
UCNG_URL=http://ucng:8080

# Musik-Ordner auf diesem Rechner (wird nach /music eingebunden; Unterordner: !folder <name>)
MUSIC_PATH=./music

# 1 = YouTube-Links und -Suche (über yt-dlp) · 0 = nur Musik aus dem Musik-Ordner, z. B.
# lizenzfreie Stücke; !play <Begriff> sucht dann in den Dateinamen. Bei 0 sind alle
# YTDLP_*-Einstellungen und CACHE_* ohne Wirkung, alte Downloads in /music/youtube werden nicht gespielt.
YOUTUBE=0

# Zwischenspeicher für YouTube: dauerhaft unter /music/youtube („Titel [ID].opus“); leer = aus.
# Linux: einmal  mkdir -p music/youtube && sudo chown 10001 music/youtube
CACHE_DIR=/music/youtube
# Größengrenze des Zwischenspeichers in GB (0 = ohne Grenze; sonst fliegt zuerst, was am längsten nicht lief)
CACHE_MAX_GB=0

# Fester Sprachkanal; leer = der Kanal, in dem der Befehl geschrieben wird
MUSIC_ROOM=
# Befehlszeichen (!play, !skip …)
PREFIX=!
# 1 = nur das Team darf die Musik steuern
TEAM_ONLY=0
# Start-Lautstärke (1–100; jede Person regelt zusätzlich selbst) und Opus-Bitrate (16–256 kbit/s)
VOLUME=20
BITRATE=128
# Höchstlänge der Warteschlange
MAX_QUEUE=500

# 1 = beim Start die neueste yt-dlp-Fassung holen (YouTube ändert sich oft)
YTDLP_UPDATE=1
# Verlangt YouTube eine Anmeldung („Sign in to confirm you’re not a bot“): Cookies eines Kontos
# als cookies.txt (Netscape-Format) neben compose.yml legen, dort die Zeile ./cookies.txt
# einkommentieren und hier setzen:  YTDLP_COOKIES=/cookies.txt
YTDLP_COOKIES=
# Weitere Optionen für yt-dlp (selten nötig), z. B. --extractor-args youtube:player_client=web
YTDLP_ARGS=
# So viele Sekunden auf den ersten Ton warten, dann Fehlermeldung mit dem Grund von YouTube
START_TIMEOUT=90
# Platz im Arbeitsspeicher für Downloads (ein Stück liegt dort, solange es läuft)
TMP_SIZE=1g

# Image-Version: latest oder fest, z. B. 1.4.0
UCNG_VERSION=latest
TZ=Europe/Berlin
