# Kopieren nach .env und anpassen (die .env nicht ins Repository einchecken).

# Token aus Admin → Bots (Rechte: Schreiben und Musik)
UCNG_BOT_TOKEN=

# Musik-Ordner auf dem Server (Unterordner gehen mit !folder <name>)
MUSIC_PATH=./music

# Chat-Server, wie der Bot ihn erreicht (gleicher Server: http://ucng:8080)
UCNG_URL=http://ucng:8080

# Fester Sprachkanal; leer = der Kanal, in dem der Befehl geschrieben wird
MUSIC_ROOM=

# Start-Lautstärke (0–100) und Opus-Bitrate (kbit/s)
VOLUME=20
BITRATE=128

# 1 = nur das Team darf die Musik steuern
TEAM_ONLY=0

# Feste Version statt latest, z. B. 1.2.3
UCNG_VERSION=latest
