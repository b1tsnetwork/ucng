# Kopieren nach .env und anpassen (die .env nicht ins Repository einchecken).

# Öffentliche Adresse des Chats, mit https://
PUBLIC_URL=https://chat.example.org

# Passwort für /admin – lang und zufällig, z. B. mit: openssl rand -base64 24
ADMIN_PASSWORD=

# simple (Namen ohne Konto) oder hosted (Konten, 2FA, verschlüsselte DMs, Föderation)
MODE=simple

# files oder sqlite
STORAGE=files

# Image-Version: latest oder fest, z. B. 1.4.0 (empfohlen für planbare Updates)
UCNG_VERSION=latest

# Lokaler Port für den Reverse-Proxy
UCNG_PORT=8080

# Weitere Seiten, die das Widget einbetten dürfen (kommagetrennt)
ALLOWED_ORIGINS=

# Anzahl täglicher Backups (3 Uhr), 0 = aus
BACKUP_KEEP=7

TZ=Europe/Berlin

# Vertrauenswürdige Proxys (leer = Loopback und private Netze). Bei einem CDN davor
# dessen Adressbereiche ergänzen, z. B. 127.0.0.1,172.16.0.0/12,173.245.48.0/20
TRUSTED_PROXIES=

# Gleichzeitige Live-Verbindungen insgesamt und je IP-Adresse
MAX_STREAMS=10000
MAX_STREAMS_PER_IP=50

# Nur bei einer eigenen, veränderten Fassung: Adresse deines Quellcodes (AGPL)
SOURCE_URL=

# Sprachkanäle: 0 = aus
VOICE=1
# Eingebauter Sprach-Relay (0 = nur zusätzliche Sprach-Server aus deploy/voice)
VOICE_BUILTIN=1
VOICE_MAX_PARTICIPANTS=200
VOICE_MAX_MBIT=50
# Schlüssel für zusätzliche Sprach-Server (leer = keine), z. B.: openssl rand -hex 32
VOICE_AGENT_TOKEN=
