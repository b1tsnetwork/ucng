# UCNG – Chat-Server: alle Einstellungen für deploy/chat/compose.yml
# Kopieren nach .env und anpassen (die .env nicht ins Repository einchecken, Rechte 600).
# Leere Werte bedeuten „Standard“. Fest im Image (nicht hier einstellbar): Listen-Adresse :8080,
# Datenordner /data (Volume), Backups /data/backups; TRUST_PROXY=1 setzt compose.yml.
# Beschreibung aller Optionen: README → Konfiguration.

# ---------------------------------------------------------------- Grundlegendes

# Öffentliche Adresse des Chats, mit https:// (Pflicht) – für Links in E-Mails, Föderation,
# Beacon und die erlaubte Herkunft der Sprach-Server
PUBLIC_URL=https://chat.example.org

# Passwort für /admin (Pflicht) – lang und zufällig, z. B.: openssl rand -base64 24
ADMIN_PASSWORD=

# simple = Namen ohne Konto · hosted = Nutzerkonten, 2FA, verschlüsselte DMs, Föderation
MODE=simple

# Image-Version: latest oder fest, z. B. 1.4.0 (empfohlen für planbare Updates)
UCNG_VERSION=latest

# Lokaler Port für den Reverse-Proxy (nur an 127.0.0.1 gebunden)
UCNG_PORT=8080

# Zeitzone des Containers (Protokoll); die Zeitzone des Chats stellst du im Admin-Bereich ein
TZ=Europe/Berlin

# ---------------------------------------------------------------- Speicher und Backups

# files (Standard), sqlite oder mysql – das offizielle Image enthält alle drei
STORAGE=files

# Nur bei sqlite/mysql: Verbindung. sqlite: Pfad (Standard /data/ucng.db);
# mysql: ucng:passwort@tcp(db:3306)/ucng  (MySQL/MariaDB selbst betreiben)
DB_DSN=

# Tägliche Backups um 3 Uhr (Chat-Zeitzone) nach /data/backups; so viele bleiben, 0 = aus
BACKUP_KEEP=7

# ---------------------------------------------------------------- Netz und Widget

# Weitere Seiten, die das Widget einbetten dürfen (kommagetrennt, * = alle).
# Leer = es gilt die Einstellung unter Admin → Widgets.
ALLOWED_ORIGINS=

# Vertrauenswürdige Proxys für X-Forwarded-For (leer = Loopback und private Netze, also auch
# das Docker-Netz). Bei einem CDN davor dessen Adressbereiche ergänzen, z. B.
# 127.0.0.1,172.16.0.0/12,173.245.48.0/20
TRUSTED_PROXIES=

# ---------------------------------------------------------------- Grenzen und Spam-Bremsen

# Nachrichten pro 10 Sekunden und IP-Adresse
RATE_LIMIT=10
# Nachrichten pro 10 Sekunden und Bot
BOT_RATE=30
# Namensreservierungen pro Minute und IP-Adresse
CLAIM_RATE=5
# Höchstzahl reservierter Namen
MAX_USERS=10000
# Ungenutzte Namen werden nach so vielen Tagen wieder frei (0 = nie)
NAME_TTL_DAYS=30
# Höchstzahl Kanäle (0 = unbegrenzt) – sinnvoll, wenn Besucher selbst Kanäle anlegen dürfen
MAX_ROOMS=0
# Gleichzeitige Live-Verbindungen insgesamt und je IP-Adresse (jeder offene Tab ist eine)
MAX_STREAMS=10000
MAX_STREAMS_PER_IP=50

# ---------------------------------------------------------------- Quellcode (AGPL)

# Nur bei einer eigenen, veränderten Fassung: Adresse deines Quellcodes.
# Offizielle Images bringen die richtige Adresse schon mit.
SOURCE_URL=

# ---------------------------------------------------------------- Sprachkanäle

# 0 = Sprachkanäle ganz aus
VOICE=1
# Eingebauter Sprach-Relay im Chat-Server (0 = Sprache nur über Sprach-Server aus deploy/voice)
VOICE_BUILTIN=1
# Grenzen des eingebauten Relays: Teilnehmer, ausgehende Bandbreite (Mbit/s, geschätzt),
# Verbindungen je IP-Adresse (je Person bis zu drei: Sprache, Bildschirm, Kameras)
VOICE_MAX_PARTICIPANTS=200
VOICE_MAX_MBIT=50
VOICE_MAX_PER_IP=40
# Schlüssel, mit dem sich weitere Sprach-Server (deploy/voice) anmelden; leer = keine.
# Erzeugen z. B. mit: openssl rand -hex 32
VOICE_AGENT_TOKEN=
# Lastverteilung in einem Kanal: Bildschirm bzw. Kameras auf einen anderen Sprach-Server
# auslagern, wenn der Server der Sprache sonst über diese Auslastung käme (Prozent der
# Bandbreite; 0 = immer auslagern, 100 = nie). Nur wirksam, wenn es weitere Sprach-Server gibt.
VOICE_OFFLOAD_SCREEN=50
VOICE_OFFLOAD_VIDEO=75

# ---------------------------------------------------------------- Untertitel und Live-Transkription

# Eigene Spracherkennung (Whisper, OpenAI-kompatibel), z. B. deploy/stt im selben Docker-Netz:
#   STT_URL=http://ucng-stt:8000/v1/audio/transcriptions
# Leer = der Chat-Server verschriftlicht nicht (Sprach-Server können eine eigene haben).
STT_URL=
# Genau das Modell, das dort installiert ist
STT_MODEL=Systran/faster-whisper-small
# Bearer-Schlüssel, falls die Spracherkennung einen verlangt (deploy/stt: STT_TOKEN dort)
STT_TOKEN=
# Sprache fest vorgeben (z. B. de); leer = Sprache der Oberfläche der sprechenden Person
STT_LANGUAGE=
# Gleichzeitige Anfragen an die Spracherkennung (für alle Kanäle zusammen)
STT_CONCURRENCY=4
# Live-Transkripte nach so vielen Tagen löschen (0 = behalten, bis der Admin sie löscht)
TRANSCRIPT_KEEP_DAYS=0

# ---------------------------------------------------------------- Nur zum Testen

# 1 = Föderation auch über http:// und zu Adressen im lokalen Netz – niemals im Betrieb!
FED_INSECURE=
